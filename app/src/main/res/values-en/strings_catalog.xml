    <string name="catalog_hardening_adb_enabled_title">ADB/debugging access is enabled</string>
    <string name="catalog_hardening_adb_enabled_why">Active ADB lets authorized debug commands and app installs access the device.</string>
    <string name="catalog_hardening_adb_enabled_recommendation">Disable debugging in developer options and reset the ADB authorizations.</string>
    <string name="catalog_hardening_adb_unknown_title">ADB status unreadable</string>
    <string name="catalog_hardening_adb_unknown_why">The setting could not be read; active ADB therefore cannot be ruled out.</string>
    <string name="catalog_hardening_adb_unknown_recommendation">Check the debugging status manually in system settings and disable it if not needed.</string>
    <string name="catalog_hardening_devoptions_enabled_title">Developer options are enabled</string>
    <string name="catalog_hardening_devoptions_enabled_why">Developer options are a prerequisite for many debug and sideload features and are rarely needed on an everyday TV.</string>
    <string name="catalog_hardening_devoptions_enabled_recommendation">Disable developer options in system settings if they are not needed for tests.</string>
    <string name="catalog_hardening_devoptions_unknown_title">Developer options status unreadable</string>
    <string name="catalog_hardening_devoptions_unknown_why">The setting could not be read; active debug access therefore cannot be ruled out.</string>
    <string name="catalog_hardening_devoptions_unknown_recommendation">Check the developer options status manually in system settings.</string>
    <string name="catalog_hardening_unknownsources_enabled_title">Own app may install from unknown sources</string>
    <string name="catalog_hardening_unknownsources_enabled_why">If the app itself may install packages from unknown sources, sideloaded packages can reach the device without store checks.</string>
    <string name="catalog_hardening_unknownsources_enabled_recommendation">Revoke the special unknown-apps permission for this app in system settings.</string>
    <string name="catalog_hardening_unknownsources_unknown_title">Install permission for unknown sources unreadable</string>
    <string name="catalog_hardening_unknownsources_unknown_why">The special permission could not be read; approval for sideloaded packages therefore cannot be ruled out.</string>
    <string name="catalog_hardening_unknownsources_unknown_recommendation">Check the unknown-sources permission manually in system settings.</string>
    <string name="catalog_hardening_testkeys_detected_title">Build with test keys or debug build detected</string>
    <string name="catalog_hardening_testkeys_detected_why">The build carries test keys, is built as \'userdebug\' or \'eng\' and is therefore not a production release build; trust statements are limited.</string>
    <string name="catalog_hardening_testkeys_detected_recommendation">Check the vendor\'s official production build and install an update if needed.</string>
    <string name="catalog_hardening_deviceadmin_detected_title">Active device administrator: {0}</string>
    <string name="catalog_hardening_deviceadmin_detected_why">Device administrators receive broad rights on the device. The app cannot assess whether this administrator is trustworthy.</string>
    <string name="catalog_hardening_deviceadmin_detected_recommendation">Check in system settings whether the administrator is needed and revoke the rights otherwise.</string>
    <string name="catalog_hardening_accessibility_detected_title">Active accessibility service outside known system packages: {0}</string>
    <string name="catalog_hardening_accessibility_detected_why">Accessibility services can observe screen content and input; an additional service on a TV requires explanation.</string>
    <string name="catalog_hardening_accessibility_detected_recommendation">Disable the accessibility service if it was not installed deliberately and check where the app came from.</string>
    <string name="catalog_hardening_installer_detected_title">App from a non-store source visible: {0}</string>
    <string name="catalog_hardening_installer_detected_why">At least one visible app was not installed via a known store; this is a check indication, not proof of malware.</string>
    <string name="catalog_hardening_installer_detected_recommendation">Check the app\'s install source and remove the app if it is not trusted.</string>
