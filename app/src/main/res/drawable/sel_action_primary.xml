<?xml version="1.0" encoding="utf-8"?>
<!--
  Primary action: metallic-gold gradient fill with dark obsidian label. D-pad focus adds the 4dp
  bright-gold ring; the label colour stays dark (high contrast on gold).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_radius_control" />
            <solid android:color="@color/tv_control_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/tv_glass_stroke_cool" />
        </shape>
    </item>

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/tv_radius_control" />
                    <solid android:color="@color/tv_gold_bright" />
                </shape>
            </item>
            <item
                android:bottom="@dimen/tv_focus_stroke"
                android:left="@dimen/tv_focus_stroke"
                android:right="@dimen/tv_focus_stroke"
                android:top="@dimen/tv_focus_stroke">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="@color/tv_accent"
                        android:startColor="@color/tv_gold_bright"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_radius_control" />
            <solid android:color="@color/tv_gold_bright" />
            <stroke
                android:width="1dp"
                android:color="@color/tv_gold_bright" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_radius_control" />
            <gradient
                android:angle="270"
                android:endColor="@color/tv_gold_gradient_bottom"
                android:startColor="@color/tv_gold_gradient_top"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/tv_accent_soft" />
        </shape>
    </item>

</selector>
