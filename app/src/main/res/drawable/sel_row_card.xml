<?xml version="1.0" encoding="utf-8"?>
<!--
  Checklist / rich row card: a soft glass surface marks a standalone item (hardening check, finding,
  metric). Focus replaces the soft edge with the 4dp bright-gold ring.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_radius_control" />
            <solid android:color="@color/tv_transparent" />
        </shape>
    </item>

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/tv_radius_control" />
                    <solid android:color="@color/tv_gold_bright" />
                </shape>
            </item>
            <item
                android:bottom="@dimen/tv_focus_stroke"
                android:left="@dimen/tv_focus_stroke"
                android:right="@dimen/tv_focus_stroke"
                android:top="@dimen/tv_focus_stroke">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="@color/tv_control_fill_focus" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_radius_control" />
            <solid android:color="@color/tv_control_fill_focus" />
            <stroke
                android:width="1dp"
                android:color="@color/tv_accent_soft" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/tv_radius_control" />
                    <gradient
                        android:angle="270"
                        android:endColor="@color/tv_glass_panel_soft"
                        android:startColor="@color/tv_panel_top"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/tv_glass_stroke_cool" />
                </shape>
            </item>
            <item
                android:height="1dp"
                android:left="18dp"
                android:right="18dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_glass_highlight" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
