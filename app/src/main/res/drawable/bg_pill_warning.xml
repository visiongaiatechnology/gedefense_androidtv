    android:shape="rectangle">
    <corners android:radius="@dimen/tv_radius_pill" />
    <solid android:color="@color/tv_pill_warning_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/tv_pill_warning_stroke" />
</shape>
