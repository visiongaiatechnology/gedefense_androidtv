<?xml version="1.0" encoding="utf-8"?>
<!-- Verified-health chip surface (green is reserved for confirmed healthy/available states). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/tv_radius_pill" />
    <solid android:color="@color/tv_pill_success_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/tv_pill_success_stroke" />
</shape>
