<?xml version="1.0" encoding="utf-8"?>
<!--
  Functional glass panel: obsidian gradient, fine gold edge, one inner top highlight.
  Used for real boundaries (hero, status, notice, checklist) - not around every list row.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_radius_panel" />
            <gradient
                android:angle="270"
                android:endColor="@color/tv_panel_bottom"
                android:startColor="@color/tv_panel_top"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/tv_glass_stroke" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:left="26dp"
        android:right="26dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_glass_highlight" />
        </shape>
    </item>
</layer-list>
