<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      GeDefense TV - standalone Android TV / Google TV security app.
      Permissions are intentionally minimal (datasheet section 4): no accessibility service,
      no overlay, no microphone/camera, no location, no QUERY_ALL_PACKAGES.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- V2: local loopback VPN runs as a foreground service (targetSdk 36 requires a declared type). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- TV-only product: requires a TV device and leanback-compatible launcher. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      Package visibility: targeted queries only (datasheet section 4). The app sees launchable TV
      apps and explicit VGT packages; it never claims a complete device inventory.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".TvApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_tv_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/TvAppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".TvMainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="landscape"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".platform.TvThreatIntelJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          V2: on-device loopback VPN. No external server: the TUN interface feeds the vendored,
          audited GaiaNet helper which filters DNS/tracker/C2 destinations and emits bounded
          telemetry. Always-on supported so a TV restart does not silently leave traffic unfiltered.
        -->
        <service
            android:name=".vpn.TvVpnService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local loopback VPN filtering DNS, tracker and C2 destinations; no external server." />
        </service>

    </application>
</manifest>
